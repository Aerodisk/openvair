# Copy to experiment/.env and fill in. Never commit .env with a real key.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Recommended for this benchmark (Structured Outputs + reasoning):
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low

# Legacy: OPENAI_MODEL=gpt-4o-2024-08-06  OPENAI_USE_RESPONSES=0

# gpt-5.5 Standard pricing (USD per 1M tokens). See https://openai.com/api/pricing/
LLM_INPUT_COST_PER_1M=5.0
LLM_OUTPUT_COST_PER_1M=30.0

# Optional: BENCHMARK_MODULES=user,storage
