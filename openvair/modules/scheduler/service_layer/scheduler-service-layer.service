[Unit]
Description=Scheduler service layer for manipulating scheduler domain
Requires=docker.service
After=network.target docker.service

[Service]
Environment="PATH=/opt/aero/openvair/.venv/bin/:/opt/aero/openvair/venv/bin/:/usr/sbin/:/usr/bin/"
Environment="PYTHONPATH=/opt/aero/openvair"
Environment=PYTHONUNBUFFERED=1

WorkingDirectory=/opt/aero/openvair
ExecStart=/opt/aero/openvair/.venv/bin/python3 -m openvair.modules.scheduler.service_layer.manager
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
